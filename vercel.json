{
  "version": 2,
  "builds": [
    { "src": "api/**/*", "use": "@vercel/node" },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/api/$1" },

    { "handle": "filesystem" },
    { "src": "^/(.*)\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|txt|json|map)$", "dest": "/$1" },

    { "src": ".*", "dest": "/index.html" }
  ]
}
