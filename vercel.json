{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/api/$1" },

    // отдать реальные файлы из frontend/dist по их путям
    { "src": "^/(.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|txt|json|map))$", "dest": "/frontend/dist/$1" },
    { "src": "^/assets/(.*)$", "dest": "/frontend/dist/assets/$1" },

    // прямой доступ к index.html (на всякий)
    { "src": "^/index.html$", "dest": "/frontend/dist/index.html" },

    // SPA fallback: все прочие пути -> index.html из frontend/dist
    { "src": "^(?!/api/).*", "dest": "/frontend/dist/index.html" }
  ]
}
