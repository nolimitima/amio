{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: clang build active file",
      "type": "shell",
      "command": "clang",
      "args": [
        "-std=c11",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
